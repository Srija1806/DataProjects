      <aliases enabled='yes' />
      <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
      <column caption='Business Travel' datatype='string' name='[BusinessTravel]' role='dimension' type='nominal' />
      <column caption='Past Employees' datatype='integer' name='[Calculation_446419327340163072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Attrition] = &quot;Yes&quot; THEN [EmployeeID]ELSE NULL END)' />
      </column>
      <column caption='Current Employees ' datatype='integer' name='[Calculation_446419327340855297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Attrition]=&quot;No&quot; THEN [EmployeeID] ELSE NULL END)' />
      </column>
      <column caption='Total Employees' datatype='integer' name='[Calculation_446419327341060098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([EmployeeID])' />
      </column>
      <column caption='Attrition Rate' datatype='real' default-format='p0%' name='[Calculation_446419327341326339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_446419327340163072] / [Calculation_446419327341060098]' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_577868143704223744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Age]&lt;20 then &quot;under 20&quot;&#13;&#10;ELSEIF [Age]&gt;=20 and [Age]&lt;29 then &quot;20-29&quot; &#13;&#10;ELSEIF [Age]&gt;=30 and [Age]&lt;=39 THEN &quot;30-39&quot;&#13;&#10;ELSEIF [Age]&gt;=40 and [Age]&lt;=49 THEN &quot;40-49&quot;&#13;&#10;ELSE &quot;over 50&quot;&#13;&#10;END' />
      </column>
      <column caption='ES Header' datatype='string' name='[Calculation_577868143706947586]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Environment Satisfaction&quot;' />
      </column>
      <column caption='Full Name' datatype='string' name='[Calculation_577868143707123715]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[FirstName]+[LastName]' />
      </column>
      <column caption='Latest Review Date' datatype='date' name='[Calculation_577868143707394052]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{Fixed [Calculation_577868143707123715]:MAX([ReviewDate])}' />
      </column>
      <column caption='Latest Environment Score' datatype='string' name='[Calculation_577868143707795461]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if DATE([Calculation_577868143707394052])=DATE([ReviewDate])&#13;&#10;THEN [EnvironmentSatisfaction] &#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Percent Change' datatype='real' default-format='p0%' name='[Calculation_806988775248515072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_446419327341060098] - LOOKUP([Calculation_446419327341060098], -1)) &#13;&#10;/ LOOKUP([Calculation_446419327341060098], -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Hire Vs Attrition Ratio' datatype='real' name='[Calculation_806988775267614721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_446419327341060098]/[Calculation_446419327341326339]' />
      </column>
      <column caption='Overall Attrition Rate' datatype='real' default-format='p0%' name='[Calculation_806988775267880962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Attrition]=&apos;Yes&apos; then 1 else 0 END)/COUNT([EmployeeID])' />
      </column>
      <column caption='Average Tenure ' datatype='real' name='[Calculation_806988775271161861]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(if [Attrition]=&apos;Yes&apos; then [YearsAtCompany] else null end)' />
      </column>
      <column caption='Average Job Satisfaction' datatype='string' name='[Calculation_806988775271743494]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(if [Attrition]=&apos;Yes&apos; then [JobSatisfaction] else null end)' />
      </column>
      <column caption='Training Opputunities Utilization' datatype='real' name='[Calculation_806988775274422279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TrainingOpportunitiesTaken])/SUM([TrainingOpportunitiesWithinYear])' />
      </column>

    <dashboard name='Story 1' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='22'>Exploring Workforce Dynamics: Tenure, Demographics, and Attrition Trends</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='292' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97898' id='1' param='vert' removable='false' type-v2='layout-flow' w='98770' x='615' y='1051'>
            <zone h='5256' id='3' type-v2='title' w='98770' x='615' y='1051' />
            <zone fixed-size='153' h='20105' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98770' x='615' y='6307' />
            <zone h='72537' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98770' x='615' y='26412'>
              <flipboard active-id='5' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='An upward trend reveals a positive correlation between average years at the company and average salary, highlighting tenure&apos;s potential impact on compensation growth.' captured-sheet='Correlation b/n years and salary' id='1' />
                  <story-point caption='The workforce is predominantly composed of employees aged 20-29, indicating a youthful demographic, with a noticeable decline in representation among older age groups.' captured-sheet='Age Group' id='2' />
                  <story-point caption='Employees with frequent business travel exhibit the highest attrition rate, while those with no travel show the lowest, suggesting a potential link between travel demands and employee turnover.' captured-sheet='Attrition by Travel' id='3' />
                  <story-point caption='Attrition is highest among employees with less than one year at the company, while longer-tenured employees show a significantly lower rate of departure, highlighting retention challenges early in tenure.' captured-sheet='Attrition by Tenure' id='4' />
                  <story-point caption='The company grew to 1,470 employees, with hiring trends and salaries highlighting HR and Technology roles as top earners.' captured-sheet='Hiring Trends Dash' id='5' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{80E47136-5B93-4197-91CC-84492080BC28}' />
    </dashboard>
